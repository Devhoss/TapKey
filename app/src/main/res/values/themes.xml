<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light palette. Selected explicitly by the in-app Light setting. -->
    <style name="Theme.TapKey.Light" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="paletteBg">@color/bg</item>
        <item name="paletteSurface">@color/surface</item>
        <item name="paletteStroke">@color/stroke</item>
        <item name="paletteTextPrimary">@color/text_primary</item>
        <item name="paletteTextSecondary">@color/text_secondary</item>
        <item name="paletteTextTertiary">@color/text_tertiary</item>
        <item name="paletteAccent">@color/accent</item>
        <item name="paletteBadgeBg">@color/badge_bg</item>
        <item name="paletteRipple">@color/ripple</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Dark palette. Selected explicitly by the in-app Dark setting, and used by
         Theme.TapKey in values-night so the System setting follows the OS. -->
    <style name="Theme.TapKey.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="paletteBg">@color/dark_bg</item>
        <item name="paletteSurface">@color/dark_surface</item>
        <item name="paletteStroke">@color/dark_stroke</item>
        <item name="paletteTextPrimary">@color/dark_text_primary</item>
        <item name="paletteTextSecondary">@color/dark_text_secondary</item>
        <item name="paletteTextTertiary">@color/dark_text_tertiary</item>
        <item name="paletteAccent">@color/dark_accent</item>
        <item name="paletteBadgeBg">@color/dark_badge_bg</item>
        <item name="paletteRipple">@color/dark_ripple</item>
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:colorAccent">@color/dark_accent</item>
        <item name="android:statusBarColor">@color/dark_bg</item>
        <item name="android:navigationBarColor">@color/dark_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- System setting: light here, dark via values-night/themes.xml. -->
    <style name="Theme.TapKey" parent="Theme.TapKey.Light" />

    <!-- No window, no animation: the tap surface must never be seen. -->
    <style name="Theme.TapKey.Invisible" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?attr/paletteTextSecondary</item>
    </style>
</resources>

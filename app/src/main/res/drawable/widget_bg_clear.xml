<?xml version="1.0" encoding="utf-8"?>
<!-- Clear: fully transparent glass. A very faint gradient and a hairline border only hint
     at the tap targets; the wallpaper shows through. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#05FFFFFF"
        android:startColor="#1FFFFFFF" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="#4DFFFFFF" />
</shape>
